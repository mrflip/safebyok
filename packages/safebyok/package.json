{
  "name": "safebyok",
  "version": "0.5.0",
  "description": "Bring-your-own-key vault: end-to-end encrypted, browser-side storage for API keys and other small secrets, over a pluggable database layer",
  "keywords": [
    "safebyok",
    "vault",
    "e2ee",
    "end-to-end-encryption",
    "api-key",
    "secrets",
    "webcrypto",
    "argon2id"
  ],
  "license": "Apache-2.0",
  "author": "Philip (flip) Kromer <flip@mrflip.com>",
  "homepage": "https://github.com/mrflip/safebyok#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrflip/safebyok.git",
    "directory": "packages/safebyok"
  },
  "bugs": {
    "url": "https://github.com/mrflip/safebyok/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CUSTOMIZATION.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "lint": "eslint --cache --cache-strategy content --cache-location .eslintcache .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "justify": "pnpm install && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "node ../../scripts/require-pnpm.ts && pnpm justify"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-chai-expect": "^4.1.1",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "@safebyok/source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "@safebyok/source": "./tests/test-helpers.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "es-toolkit": "^1.53.0",
    "safe-stable-stringify": "^3.0.0"
  },
  "peerDependencies": {
    "zod": "^4.6.7",
    "vitest": "^5.0.0"
  },
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing.d.cts"
      ]
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./testing": {
        "import": "./dist/testing.js",
        "require": "./dist/testing.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
