{
  "name": "safebyok",
  "version": "0.0.0",
  "private": true,
  "description": "The lean core of safebyok: the device, bank, gate, gating, wayins, provings and lease, with no storage of their own",
  "license": "Apache-2.0",
  "author": "Philip (flip) Kromer <flip@mrflip.com>",
  "homepage": "https://github.com/mrflip/safebyok#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrflip/safebyok.git",
    "directory": "packages/safebyok"
  },
  "bugs": {
    "url": "https://github.com/mrflip/safebyok/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/front-door.ts . ./core ./storage ./utils",
    "prebuild": "pnpm build:deps",
    "build:watch": "tsdown --watch",
    "build:deps": "[ \"$SAFEBYOK_SKIP_BUILD_DEPS\" = 1 ] || SAFEBYOK_SKIP_BUILD_DEPS=1 pnpm --filter 'safebyok^...' build",
    "lint": "eslint --cache --cache-strategy content --cache-location .eslintcache .",
    "typecheck": "tsc --noEmit && node ../../scripts/forgotten-exports.ts .",
    "test": "vitest run",
    "pretest": "pnpm build:deps",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage": "pnpm build:deps",
    "justify": "pnpm install && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/query-core": "^5.107.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-chai-expect": "^4.1.1",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsdoc": "^65.4.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "fake-indexeddb": "^6.2.8",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "exports": {
    ".": {
      "@safebyok/source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "@safebyok/source": "./src/browser.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./core": {
      "@safebyok/source": "./src/core.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./storage": {
      "@safebyok/source": "./src/storage.ts",
      "import": "./dist/storage.js",
      "require": "./dist/storage.cjs"
    },
    "./testing": {
      "@safebyok/source": "./tests/test-helpers.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./utils": {
      "@safebyok/source": "./src/utils.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "es-toolkit": "^1.53.2",
    "idb-keyval": "^6.3.0",
    "safebyok-big": "workspace:*",
    "type-fest": "^5.10.0",
    "uuid": "^14.0.3"
  },
  "peerDependencies": {
    "@tanstack/query-core": "^5.107.1",
    "vitest": "^5.0.0",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./browser": {
        "import": "./dist/browser.js",
        "require": "./dist/browser.cjs"
      },
      "./core": {
        "import": "./dist/core.js",
        "require": "./dist/core.cjs"
      },
      "./storage": {
        "import": "./dist/storage.js",
        "require": "./dist/storage.cjs"
      },
      "./testing": {
        "import": "./dist/testing.js",
        "require": "./dist/testing.cjs"
      },
      "./utils": {
        "import": "./dist/utils.js",
        "require": "./dist/utils.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "browser": [
        "./dist/browser.d.cts"
      ],
      "core": [
        "./dist/core.d.cts"
      ],
      "storage": [
        "./dist/storage.d.cts"
      ],
      "utils": [
        "./dist/utils.d.cts"
      ],
      "testing": [
        "./dist/testing.d.cts"
      ]
    }
  }
}
