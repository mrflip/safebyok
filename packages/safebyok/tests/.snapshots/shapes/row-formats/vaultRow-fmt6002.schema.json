{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^(?!\\.+$)[A-Za-z0-9_.~:@+\\|%\\-]+$"
        },
        "banklabel": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^(?!.*__)[a-z][a-z0-9_]*[a-z0-9]$"
        },
        "vaultlabel": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^(?!.*__)[a-z][a-z0-9_]*[a-z0-9]$"
        },
        "fmt": {
          "type": "number",
          "const": 6002
        },
        "revision_tok": {
          "type": "string",
          "minLength": 1
        },
        "revision_seq": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "registered_at": {
          "type": "integer",
          "minimum": 347155200000,
          "maximum": 9007199254740
        },
        "written_at": {
          "type": "integer",
          "minimum": 347155200000,
          "maximum": 9007199254740
        },
        "am": {
          "type": "string",
          "const": "a"
        },
        "vault_tok": {
          "type": "string",
          "minLength": 1
        },
        "gate": {
          "type": "object",
          "properties": {
            "gate_epoch": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "passphrase_wayin": {
              "type": "object",
              "properties": {
                "wayinkind": {
                  "type": "string",
                  "const": "passphrase"
                },
                "key_deriver_label": {
                  "type": "string",
                  "minLength": 1
                },
                "salt_b64": {
                  "type": "string",
                  "minLength": 22,
                  "maxLength": 22,
                  "pattern": "^[A-Za-z0-9_\\-]+$"
                },
                "device_tok": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "registered_at": {
                  "type": "integer",
                  "minimum": 347155200000,
                  "maximum": 9007199254740
                },
                "bank_key_wayin_wrapped": {
                  "type": "object",
                  "properties": {
                    "cipher_iv_b64": {
                      "type": "string",
                      "minLength": 1
                    },
                    "ciphertext_b64": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "cipher_iv_b64",
                    "ciphertext_b64"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "wayinkind",
                "key_deriver_label",
                "salt_b64",
                "device_tok",
                "registered_at",
                "bank_key_wayin_wrapped"
              ],
              "additionalProperties": false
            },
            "passkey_wayin": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "wayinkind": {
                      "type": "string",
                      "const": "passkey"
                    },
                    "credential_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "prf_salt_b64": {
                      "type": "string",
                      "minLength": 1
                    },
                    "device_tok": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "registered_at": {
                      "type": "integer",
                      "minimum": 347155200000,
                      "maximum": 9007199254740
                    },
                    "bank_key_wayin_wrapped": {
                      "type": "object",
                      "properties": {
                        "cipher_iv_b64": {
                          "type": "string",
                          "minLength": 1
                        },
                        "ciphertext_b64": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "cipher_iv_b64",
                        "ciphertext_b64"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "wayinkind",
                    "credential_id",
                    "prf_salt_b64",
                    "device_tok",
                    "registered_at",
                    "bank_key_wayin_wrapped"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "gate_epoch",
            "passphrase_wayin",
            "passkey_wayin"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "user_id",
        "banklabel",
        "vaultlabel",
        "fmt",
        "revision_tok",
        "revision_seq",
        "registered_at",
        "written_at",
        "am",
        "vault_tok",
        "gate"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^(?!\\.+$)[A-Za-z0-9_.~:@+\\|%\\-]+$"
        },
        "banklabel": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^(?!.*__)[a-z][a-z0-9_]*[a-z0-9]$"
        },
        "vaultlabel": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^(?!.*__)[a-z][a-z0-9_]*[a-z0-9]$"
        },
        "fmt": {
          "type": "number",
          "const": 6002
        },
        "revision_tok": {
          "type": "string",
          "minLength": 1
        },
        "revision_seq": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "registered_at": {
          "type": "integer",
          "minimum": 347155200000,
          "maximum": 9007199254740
        },
        "written_at": {
          "type": "integer",
          "minimum": 347155200000,
          "maximum": 9007199254740
        },
        "am": {
          "type": "string",
          "const": "x"
        },
        "vault_tok": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "user_id",
        "banklabel",
        "vaultlabel",
        "fmt",
        "revision_tok",
        "revision_seq",
        "registered_at",
        "written_at",
        "am",
        "vault_tok"
      ],
      "additionalProperties": false
    }
  ]
}
