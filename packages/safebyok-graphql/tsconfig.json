{
  // The GraphQL adapter. src/ is platform-neutral: one part runs in the browser and the other on
  // the host's server (Node, Bun, Deno, an edge runtime), and neither uses an API specific to one
  // of them. Tests and configs run under Node, with PGlite as the database. eslint keeps Node's
  // modules and globals out of src/. The DOM lib is needed for two reasons: the workspace reads
  // the core's source, whose WebCrypto types come from it, and the resolvers use the web-standard
  // ReadableStream.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "tests",
    "*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}
