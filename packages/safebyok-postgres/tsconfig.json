{
  // The Postgres adapter. src/ is platform-neutral: it runs on the host's server (Node, Bun, Deno,
  // an edge runtime) and uses no API specific to any of them. Tests and configs run under Node,
  // with PGlite as the database. eslint keeps Node's modules and globals out of src/. The DOM lib
  // is needed because the workspace reads the core's source, whose WebCrypto types come from it.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "tests",
    "*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}
