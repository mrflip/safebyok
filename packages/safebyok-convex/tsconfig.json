{
  // The Convex adapter: its component runs in Convex's default runtime, a V8 isolate with the web
  // platform's globals (fetch, WebCrypto), which the DOM lib types.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src",
    "tests",
    "*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}
