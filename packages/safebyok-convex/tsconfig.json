{
  // The Convex adapter: its component runs in Convex's default runtime, a V8 isolate with the web
  // platform's globals (fetch, WebCrypto), which the DOM lib types.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    // Off until convex-helpers 0.1.129 passes its seven days (2026-10-28): 0.1.128 ships its .ts
    // sources beside its .d.ts, TypeScript resolves an import to the .ts first and checks it, and
    // one class there takes its fields as constructor parameters, which this flag refuses. 0.1.129
    // ships no .ts: raise the floor to it and delete this.
    "erasableSyntaxOnly": false
  },
  "include": [
    "src",
    "tests",
    "*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}
