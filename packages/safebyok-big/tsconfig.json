{
  // The core: platform-neutral src/, whose WebCrypto and IndexedDB are typed by the DOM lib, and
  // tests and configs run under Node. eslint keeps Node's modules and globals out of src/.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "tests",
    "*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}
