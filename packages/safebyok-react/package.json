{
  "name": "safebyok-react",
  "private": false,
  "version": "0.5.0",
  "description": "React binding for safebyok: the giver, the provider, and the parts and kit of forms built on them.",
  "keywords": [
    "safebyok",
    "react",
    "vault",
    "e2ee"
  ],
  "license": "Apache-2.0",
  "author": "Philip (flip) Kromer <flip@mrflip.com>",
  "homepage": "https://github.com/mrflip/safebyok#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrflip/safebyok.git",
    "directory": "packages/safebyok-react"
  },
  "bugs": {
    "url": "https://github.com/mrflip/safebyok/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "prebuild": "pnpm build:deps",
    "build:watch": "tsdown --watch",
    "build:deps": "[ \"$SAFEBYOK_SKIP_BUILD_DEPS\" = 1 ] || SAFEBYOK_SKIP_BUILD_DEPS=1 pnpm --filter 'safebyok-react^...' build",
    "lint": "eslint --cache --cache-strategy content --cache-location .eslintcache .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest": "pnpm build:deps",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage": "pnpm build:deps",
    "justify": "pnpm install && pnpm lint && pnpm typecheck && pnpm test && SAFEBYOK_SKIP_BUILD_DEPS=1 pnpm build",
    "prepublishOnly": "node ../../scripts/require-pnpm.ts && pnpm justify"
  },
  "dependencies": {
    "es-toolkit": "^1.53.2"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/react-query": "^5.108.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-chai-expect": "^4.1.1",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsdoc": "^65.4.12",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^80.0.0",
    "jsdom": "^31.0.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "safebyok": "workspace:*",
    "tsdown": "^0.23.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "use-effect-event": "^2.0.4",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.108.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "safebyok": "workspace:^",
    "use-effect-event": "^2.0.4",
    "vitest": "^5.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "@safebyok/source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./kit": {
      "@safebyok/source": "./src/kit/index.ts",
      "import": "./dist/kit/index.js",
      "require": "./dist/kit/index.cjs"
    },
    "./parts": {
      "@safebyok/source": "./src/parts/index.ts",
      "import": "./dist/parts/index.js",
      "require": "./dist/parts/index.cjs"
    },
    "./testing": {
      "@safebyok/source": "./tests/testing.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./kit": {
        "import": "./dist/kit/index.js",
        "require": "./dist/kit/index.cjs"
      },
      "./parts": {
        "import": "./dist/parts/index.js",
        "require": "./dist/parts/index.cjs"
      },
      "./testing": {
        "import": "./dist/testing.js",
        "require": "./dist/testing.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "typesVersions": {
    "*": {
      "parts": [
        "./dist/parts/index.d.cts"
      ],
      "kit": [
        "./dist/kit/index.d.cts"
      ],
      "testing": [
        "./dist/testing.d.cts"
      ]
    }
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
