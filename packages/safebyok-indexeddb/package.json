{
  "name": "safebyok-indexeddb",
  "private": false,
  "version": "0.3.0",
  "description": "IndexedDB storage for safebyok: a VaultDB that keeps vault bundles and lockboxes as ciphertext in this browser, each verb one IndexedDB transaction, and the template for a key-value backend of your own.",
  "keywords": [
    "safebyok",
    "indexeddb",
    "vault",
    "e2ee"
  ],
  "license": "Apache-2.0",
  "author": "Philip (flip) Kromer <flip@mrflip.com>",
  "homepage": "https://github.com/mrflip/safebyok#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrflip/safebyok.git",
    "directory": "packages/safebyok-indexeddb"
  },
  "bugs": {
    "url": "https://github.com/mrflip/safebyok/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "prebuild": "pnpm build:deps",
    "build:watch": "tsdown --watch",
    "build:deps": "[ \"$SAFEBYOK_SKIP_BUILD_DEPS\" = 1 ] || SAFEBYOK_SKIP_BUILD_DEPS=1 pnpm --filter 'safebyok-indexeddb^...' build",
    "lint": "eslint --cache --cache-strategy content --cache-location .eslintcache .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest": "pnpm build:deps",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage": "pnpm build:deps",
    "justify": "pnpm install && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "node ../../scripts/require-pnpm.ts && pnpm justify"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-chai-expect": "^4.1.1",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "fake-indexeddb": "^6.2.5",
    "publint": "^0.3.25",
    "safebyok": "workspace:*",
    "tsdown": "^0.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "safebyok": "workspace:^",
    "zod": "^4.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "@safebyok/source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  }
}
