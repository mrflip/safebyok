{
  // The cross-harness tests: Convex's fake deployment is a Node-side fake of a WebSocket, and the
  // clients are the browser builds, so the DOM lib types both.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    // Off until convex-helpers 0.1.129 passes its seven days (2026-10-28), as in
    // packages/safebyok-convex/tsconfig.json, which says why.
    "erasableSyntaxOnly": false
  },
  "include": [
    "tests",
    "*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "coverage"
  ]
}
