+/** A placeholder until the helpers worker lands `tattoo`; then this goes and the import takes its place. */
+export function tattoo<BT extends object>(obj: object, shown: BT, opts: { writable?: boolean, configurable?: boolean } = {}): BT {
+  for (const [ckey, val] of Object.entries(shown)) {
+    Object.defineProperty(obj, ckey, { value: val, enumerable: true, writable: opts.writable ?? true, configurable: opts.configurable ?? true })
+  }
+  return shown
+}
+
+/** A placeholder until the helpers worker lands `tattoo`; then this goes and the import takes its place. */
+export function tattooProp<VT>(obj: object, propname: string, val: VT, opts: { writable?: boolean, configurable?: boolean } = {}): VT {
+  Object.defineProperty(obj, propname, { value: val, enumerable: true, writable: opts.writable ?? true, configurable: opts.configurable ?? true })
+  return val
+}
