{
  "name": "safebyok-demo-react",
  "private": true,
  "version": "0.0.0",
  "description": "Single-page React playground for the safebyok interface: a stub vault, a fake sign-in, and an inspector showing what lands where. Never published.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint --cache --cache-strategy content --cache-location .eslintcache .",
    "build:deps": "[ \"$SAFEBYOK_SKIP_BUILD_DEPS\" = 1 ] || SAFEBYOK_SKIP_BUILD_DEPS=1 pnpm --filter 'safebyok-demo-react^...' build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "pretest": "pnpm build:deps",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage": "pnpm build:deps",
    "justify": "pnpm install && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "safebyok": "workspace:*",
    "safebyok-indexeddb": "workspace:*",
    "safebyok-react": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-chai-expect": "^4.1.1",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
