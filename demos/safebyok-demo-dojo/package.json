{
  "name": "safebyok-demo-dojo",
  "private": true,
  "version": "0.0.0",
  "description": "The dojo: a page for producing, on demand, each outcome of the forms around a safebyok vault, and looking at what the form and the stores behind it hold afterwards. Never published.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prebuild": "pnpm build:deps",
    "lint": "eslint --cache --cache-strategy content --cache-location .eslintcache .",
    "build:deps": "[ \"$SAFEBYOK_SKIP_BUILD_DEPS\" = 1 ] || SAFEBYOK_SKIP_BUILD_DEPS=1 pnpm --filter 'safebyok-demo-dojo^...' build",
    "fixture": "pnpm build:deps && node scripts/make-fixture.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "pretest": "pnpm build:deps",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage": "pnpm build:deps",
    "justify": "pnpm install && pnpm lint && pnpm typecheck && pnpm test && SAFEBYOK_SKIP_BUILD_DEPS=1 pnpm build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "es-toolkit": "^1.53.2",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "safebyok": "workspace:*",
    "safebyok-indexeddb": "workspace:*",
    "safebyok-react": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-chai-expect": "^4.1.1",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsdoc": "^65.4.12",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^80.0.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
